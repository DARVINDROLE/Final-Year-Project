# Copy this file to `.env` and fill in your values.

# Frontend ─────────────────────────────────────────────────
# Leave empty to auto-resolve from window.location (LAN-friendly default).
# Only set this if you need to point the frontend at a backend on a specific host.
# Example for Pi visitor frontend talking to a laptop backend on the same WiFi:
#   VITE_API_URL=http://192.168.1.42:8000
VITE_API_URL=

# Backend ──────────────────────────────────────────────────
# Get a free key at https://console.groq.com — used for Whisper STT and LLM replies.
# If unset, the backend falls back to VOSK (offline) and canned replies.
GROQ_API_KEY=

# Optional. Default: data/db.sqlite
# DOORBELL_DB_PATH=data/db.sqlite

# Optional. Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional model gates ─────────────────────────────────────
# Set to "1" to skip loading all heavy models (useful on the Raspberry Pi or in tests).
# DOORBELL_DISABLE_MODELS=1
# Set to "1" to skip only YOLO/weapon model loading.
# DOORBELL_DISABLE_YOLO=1
